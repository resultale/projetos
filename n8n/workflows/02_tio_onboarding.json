    {
      "parameters": {
        "jsCode": "const msg = $('Detectar Etapa').item.json.mensagem.trim().toLowerCase();\nlet sexo = 'nao_informado';\nif (msg === '1' || /\\bmasculino\\b|\\bhomem\\b|\\bmacho\\b/.test(msg)) sexo = 'masculino';\nelse if (msg === '2' || /\\bfeminino\\b|\\bmulher\\b/.test(msg)) sexo = 'feminino';\nreturn [{ json: { sexo } }];"
      },
      "id": "processar-sexo",
      "name": "Processar Sexo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
