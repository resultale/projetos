        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 100,\n  \"system\": \"O usuário está informando o nome completo. Extraia APENAS o nome completo da pessoa da mensagem. Se não houver um nome, retorne 'NAO_IDENTIFICADO'. Responda só o nome, sem mais nada.\",\n  \"messages\": [{ \"role\": \"user\", \"content\": \"{{ $('Detectar Etapa').item.json.mensagem }}\" }]\n}"
