{
  "name": "02 TIO Onboarding",
  "nodes": [
    {
      "parameters": {
        "inputDataFieldName": "body"
      },
      "id": "trigger-start",
      "name": "Chamado pelo Maestro",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [120, 400]
    },
    {
      "parameters": {
        "jsCode": "const dados = $json;\nconst contexto = dados.sessao_contexto || {};\nconst etapa = contexto.etapa || 'inicio';\nreturn [{ json: { etapa, mensagem: dados.mensagem, dados, contexto } }];"
      },
      "id": "detectar-etapa",
      "name": "Detectar Etapa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [340, 400]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.etapa }}", "rightValue": "inicio", "operator": { "type": "string", "operation": "equals" } }] },
              "renameOutput": true,
              "outputKey": "inicio"
            },
            {
              "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.etapa }}", "rightValue": "aguardando_nome", "operator": { "type": "string", "operation": "equals" } }] },
              "renameOutput": true,
              "outputKey": "aguardando_nome"
            },
            {
              "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.etapa }}", "rightValue": "aguardando_sexo", "operator": { "type": "string", "operation": "equals" } }] },
              "renameOutput": true,
              "outputKey": "aguardando_sexo"
            },
            {
              "conditions": { "options": { "caseSensitive": false }, "conditions": [{ "leftValue": "={{ $json.etapa }}", "rightValue": "aguardando_endereco", "operator": { "type": "string", "operation": "equals" } }] },
              "renameOutput": true,
              "outputKey": "aguardando_endereco"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "switch-etapa",
      "name": "Switch Etapa",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [560, 400]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 100,\n  \"system\": \"Você extrai o nome de uma cidade brasileira de uma mensagem. Responda APENAS com o nome da cidade em formato limpo (ex: 'São Paulo', 'Belo Horizonte'). Se não encontrar cidade, responda 'NAO_IDENTIFICADO'.\",\n  \"messages\": [{ \"role\": \"user\", \"content\": \"{{ $('Detectar Etapa').item.json.mensagem }}\" }]\n}"
      },
      "id": "ia-extrair-cidade",
      "name": "IA: Extrair Cidade",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [800, 240]
    },
    {
      "parameters": {
        "jsCode": "const resp = $json;\nconst cidade = resp.content?.[0]?.text?.trim() || 'NAO_IDENTIFICADO';\nreturn [{ json: { cidade_texto: cidade } }];"
      },
      "id": "extrair-cidade-resp",
      "name": "Extrair Cidade da Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 240]
    },
