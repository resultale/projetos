        "jsonBody": "={\n  \"p_sessao_id\": \"{{ $('Chamado pelo Maestro').item.json.sessao_id }}\",\n  \"p_motor\": \"onboarding\",\n  \"p_contexto\": {\n    \"etapa\": \"aguardando_confirmacao_endereco\",\n    \"cidade_id\": \"{{ $('Detectar Etapa').item.json.contexto.cidade_id }}\",\n    \"cidade_nome\": \"{{ $('Detectar Etapa').item.json.contexto.cidade_nome }}\",\n    \"nome\": \"{{ $('Detectar Etapa').item.json.contexto.nome }}\",\n    \"sexo\": \"{{ $('Detectar Etapa').item.json.contexto.sexo }}\",\n    \"endereco_formatado\": \"{{ $('Extrair Coordenadas').item.json.endereco_formatado }}\",\n    \"latitude\": {{ $('Extrair Coordenadas').item.json.latitude }},\n    \"longitude\": {{ $('Extrair Coordenadas').item.json.longitude }}\n  }\n}"
      },
      "id": "salvar-endereco",
