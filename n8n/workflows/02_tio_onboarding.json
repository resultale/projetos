        "jsonBody": "={\n  \"number\": \"{{ $('Chamado pelo Maestro').item.json.telefone }}\",\n  \"text\": \"Prazer, *{{ $('Detectar Etapa').item.json.mensagem.trim() }}*! 😊\\n\\nQual é o seu sexo?\\n\\n*1* - Masculino\\n*2* - Feminino\\n*3* - Prefiro não informar\"\n}"
      },
