    {
      "parameters": {
        "jsCode": "const msg = $('Detectar Etapa').item.json.mensagem.trim().toLowerCase();\nconst map = { '1': 'casa', '2': 'trabalho', '3': 'academia', '4': 'outro' };\nlet tipo = map[msg];\nif (!tipo) {\n  if (/casa|home/.test(msg)) tipo = 'casa';\n  else if (/trabalho|work|escrit/.test(msg)) tipo = 'trabalho';\n  else if (/academia|gym/.test(msg)) tipo = 'academia';\n  else tipo = 'outro';\n}\nreturn [{ json: { tipo_endereco: tipo } }];"
      },
      "id": "processar-tipo",
      "name": "Processar Tipo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 1180]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Detectar Etapa').item.json.contexto;\nconst tipo = $('Processar Tipo').item.json.tipo_endereco;\nconst telefone = $('Chamado pelo Maestro').item.json.telefone;\nconst ultimos4 = telefone.replace(/\\D/g,'').slice(-4);\nreturn [{ json: { ...ctx, tipo_endereco: tipo, senha_inicial: ultimos4 } }];"
      },
      "id": "preparar-criacao",
      "name": "Preparar Criação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
