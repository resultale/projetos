        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_motorista_id\": \"{{ $('Chamado pelo Maestro').item.json.usuario.id }}\",\n  \"p_cidade_id\": \"{{ $('Chamado pelo Maestro').item.json.usuario.cidade_id }}\",\n  \"p_origem\": \"{{ $('Chamado pelo Maestro').item.json.usuario.cidade_nome }}\",\n  \"p_destino\": \"{{ $('Processar Dados Carona').item.json.destino }}\",\n  \"p_data_hora\": \"{{ $('Processar Dados Carona').item.json.data + ' ' + $('Processar Dados Carona').item.json.hora }}\",\n  \"p_total_vagas\": {{ $('Processar Dados Carona').item.json.vagas }},\n  \"p_valor_total\": {{ $('Processar Dados Carona').item.json.valor }}\n}"
      },
