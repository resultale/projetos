        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $('Chamado pelo Maestro').item.json.telefone }}\",\n  \"text\": \"Para buscar uma carona, me diz:\\n\\n📍 Qual é o *destino*?\\n📅 Para qual *data*?\"\n}"
      },
