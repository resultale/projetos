        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_sessao_id\": \"{{ $('Chamado pelo Maestro').item.json.sessao_id }}\",\n  \"p_motor\": \"motor_2_carona\",\n  \"p_contexto\": {\n    \"etapa\": \"aguardando_detalhes_publicar\",\n    \"modo\": \"publicar\",\n    \"dados_parciais\": {{ JSON.stringify($('Processar Dados Carona').item.json) }}\n  }\n}"
      },
