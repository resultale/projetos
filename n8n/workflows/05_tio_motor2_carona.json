      "typeVersion": 1,
      "position": [120, 400]
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\nconst ctx = d.sessao_contexto || {};\nconst etapa = ctx.etapa || 'inicio';\nreturn [{ json: { etapa, mensagem: d.mensagem, dados: d, contexto: ctx } }];"
      },
      "id": "detectar-etapa",
      "name": "Detectar Etapa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [340, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 20,\n  \"system\": \"O usuário quer usar carona compartilhada. Identifique se ele quer PUBLICAR uma carona (é motorista oferecendo) ou BUSCAR uma carona (é passageiro procurando). Responda APENAS: 'publicar' ou 'buscar'.\",\n  \"messages\": [{ \"role\": \"user\", \"content\": \"{{ $('Detectar Etapa').item.json.mensagem }}\" }]\n}"
      },
      "id": "ia-publicar-buscar",
      "name": "IA: Publicar ou Buscar?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [560, 400]
    },
    {
      "parameters": {
        "jsCode": "const resp = $json;\nconst modo = resp.content?.[0]?.text?.trim().toLowerCase() || 'buscar';\nreturn [{ json: { modo } }];"
      },
      "id": "extrair-modo",
      "name": "Extrair Modo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [{ "leftValue": "={{ $json.modo }}", "rightValue": "publicar", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        }
      },
      "id": "if-publicar",
      "name": "Publicar ou Buscar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 400]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 300,\n  \"system\": \"O usuário é motorista e quer publicar uma carona. Extraia as informações da mensagem e responda em JSON: { destino, data, hora, vagas, valor }. Se algum campo não foi mencionado, coloque null. Responda APENAS o JSON.\",\n  \"messages\": [{ \"role\": \"user\", \"content\": \"{{ $('Detectar Etapa').item.json.mensagem }}\" }]\n}"
      },
      "id": "ia-extrair-carona",
      "name": "IA: Extrair Dados Carona",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1220, 260]
    },
    {
      "parameters": {
        "jsCode": "const resp = $json;\nlet dados = {};\ntry {\n  const texto = resp.content?.[0]?.text?.trim() || '{}';\n  dados = JSON.parse(texto);\n} catch(e) {\n  dados = {};\n}\nconst completo = dados.destino && dados.data && dados.hora && dados.vagas && dados.valor;\nreturn [{ json: { ...dados, completo: !!completo } }];"
      },
      "id": "processar-carona",
      "name": "Processar Dados Carona",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [{ "leftValue": "={{ $json.completo }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }],
          "combinator": "and"
        }
      },
      "id": "if-dados-completos",
      "name": "Dados Completos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1660, 260]
    },
    {
      "parameters": {
