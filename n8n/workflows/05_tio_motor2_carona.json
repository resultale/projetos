        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $('Chamado pelo Maestro').item.json.telefone }}\",\n  \"text\": \"✅ *Carona publicada!*\\n\\n🚗 {{ $('Processar Dados Carona').item.json.destino }}\\n📅 {{ $('Processar Dados Carona').item.json.data }} às {{ $('Processar Dados Carona').item.json.hora }}\\n💺 {{ $('Processar Dados Carona').item.json.vagas }} vagas\\n💰 R$ {{ $('Processar Dados Carona').item.json.valor }}/passageiro\\n\\nPassageiros interessados entrarão em contato!\"\n}"
      },
      "id": "msg-carona-publicada",
      "name": "MSG: Carona Publicada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2100, 360]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
