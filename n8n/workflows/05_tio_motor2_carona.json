        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $('Chamado pelo Maestro').item.json.telefone }}\",\n  \"text\": \"Para publicar sua carona preciso de mais detalhes:\\n\\n{{ !$('Processar Dados Carona').item.json.destino ? '📍 Qual é o *destino*?\\n' : '' }}{{ !$('Processar Dados Carona').item.json.data ? '📅 Qual é a *data* da viagem?\\n' : '' }}{{ !$('Processar Dados Carona').item.json.hora ? '🕐 Qual é o *horário* de saída?\\n' : '' }}{{ !$('Processar Dados Carona').item.json.vagas ? '💺 Quantas *vagas* disponíveis?\\n' : '' }}{{ !$('Processar Dados Carona').item.json.valor ? '💰 Qual o *valor* por passageiro?' : '' }}\"\n}"
      },
