          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_cidade_id\": \"{{ $('Chamado pelo Maestro').item.json.usuario.cidade_id }}\",\n  \"p_destino\": \"{{ $('Processar Busca').item.json.destino }}\",\n  \"p_data\": \"{{ $('Processar Busca').item.json.data || '' }}\"\n}"
      },
      "id": "buscar-caronas",
      "name": "Buscar Caronas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1880, 660]
    },
    {
      "parameters": {
        "jsCode": "const caronas = Array.isArray($json) ? $json : [];\nif (caronas.length === 0) {\n  return [{ json: { texto: '😔 Não encontrei caronas disponíveis para esse destino.\\n\\nTente outro destino ou data, ou publique sua própria carona!', encontrou: false } }];\n}\nconst lista = caronas.slice(0, 5).map((c, i) => `${i+1}. 🚗 ${c.motorista_nome} → ${c.destino}\\n   📅 ${c.data_hora}\\n   💺 ${c.vagas_disponiveis} vagas | 💰 R$ ${c.valor_por_vaga}/vaga`).join('\\n\\n');\nreturn [{ json: { texto: `Encontrei estas caronas:\\n\\n${lista}\\n\\nDigite o número da carona que deseja!`, encontrou: true, caronas } }];"
      },
