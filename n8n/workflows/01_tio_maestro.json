      "id": "obter-sessao",
      "name": "Obter Sessão",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1660, 400]
    },
    {
      "parameters": {
        "jsCode": "const sessao = $('Obter Sessão').item.json;\nconst usuario = $('Buscar Usuário').item.json;\nconst msg = $('Extrair Dados').item.json.mensagem.toLowerCase().trim();\n\n// Se há motor em andamento, continuar nele\nif (sessao.motor_atual) {\n  return [{ json: {\n    intent: sessao.motor_atual,\n    usuario,\n    sessao,\n    mensagem: $('Extrair Dados').item.json.mensagem,\n    telefone: $('Extrair Dados').item.json.telefone,\n    sessao_id: sessao.id,\n    sessao_contexto: sessao.contexto\n  } }];\n}\n\n// Menu numerado: 1-6\nconst menuMap = {\n  '1': 'motor_1_corrida',\n  '2': 'motor_1_entrega',\n  '3': 'motor_2_carona',\n  '4': 'motor_3_servico',\n  '5': 'motor_4_reparo',\n  '6': 'motor_5_delivery'\n};\nif (menuMap[msg]) {\n  return [{ json: {\n    intent: menuMap[msg],\n    usuario, sessao,\n    mensagem: $('Extrair Dados').item.json.mensagem,\n    telefone: $('Extrair Dados').item.json.telefone,\n    sessao_id: sessao.id,\n    sessao_contexto: sessao.contexto\n  } }];\n}\n\n// Palavras-chave como atalho\nlet intent = 'menu_principal';\nif (/\\b(moto|corrida|carro|uber|taxi|motorista|me leva)\\b/.test(msg)) intent = 'motor_1_corrida';\nelse if (/\\b(entrega|entregar|motoboy|pacote|levar|enviar)\\b/.test(msg)) intent = 'motor_1_entrega';\nelse if (/\\b(carona|compartilh|viagem|passageiro)\\b/.test(msg)) intent = 'motor_2_carona';\nelse if (/\\b(cortar|barbearia|cabelo|sal[aã]o|manicure|massagem|est[eé]tica)\\b/.test(msg)) intent = 'motor_3_servico';\nelse if (/\\b(encanador|eletricista|reparo|consert|pintor|chuveiro|vazamento)\\b/.test(msg)) intent = 'motor_4_reparo';\nelse if (/\\b(pizza|hamburguer|comida|delivery|lanche|restaurante|fome|pedir)\\b/.test(msg)) intent = 'motor_5_delivery';\n\nreturn [{ json: {\n  intent,\n  usuario, sessao,\n  mensagem: $('Extrair Dados').item.json.mensagem,\n  telefone: $('Extrair Dados').item.json.telefone,\n  sessao_id: sessao.id,\n  sessao_contexto: sessao.contexto\n} }];"
      },
