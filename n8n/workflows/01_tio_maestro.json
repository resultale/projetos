    {
      "parameters": {
        "jsCode": "// Detecta intenção da mensagem e retorna o motor correspondente\nconst msg = $('Extrair Dados').item.json.mensagem.toLowerCase();\n\nlet motor = 'menu_principal';\n\nif (/\\bmoto\\b|\\bcorrida\\b|\\buber\\b|\\b99\\b|\\bindriver\\b/.test(msg)) {\n  motor = 'motor_1_corrida';\n} else if (/\\bentrega\\b|\\bentregar\\b|\\bmotoboy\\b/.test(msg)) {\n  motor = 'motor_1_entrega';\n} else if (/\\bcarona\\b|\\bvou pra\\b|\\bviagem\\b|\\bvou para\\b/.test(msg)) {\n  motor = 'motor_2_carona';\n} else if (/\\bcabelo\\b|\\bbarba\\b|\\bcortar\\b|\\bbarbearia\\b|\\bsal.o\\b|\\bmassagem\\b/.test(msg)) {\n  motor = 'motor_3_servico';\n} else if (/\\bchuveir\\b|\\bvazamento\\b|\\bencanador\\b|\\beletricista\\b|\\breparo\\b|\\bpintor\\b/.test(msg)) {\n  motor = 'motor_4_reparo';\n} else if (/\\bpizza\\b|\\bhamb.rguer\\b|\\bcomida\\b|\\bdelivery\\b|\\bpedido\\b|\\brestaurante\\b|\\blanche\\b/.test(msg)) {\n  motor = 'motor_5_delivery';\n}\n\nreturn [{ json: { motor, mensagem: msg } }];"
      },
