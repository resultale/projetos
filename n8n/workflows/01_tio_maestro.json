            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "motor_1_entrega", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "entrega" },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "motor_2_carona", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "carona" },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "motor_3_servico", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "servico" },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "motor_4_reparo", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "reparo" },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.intent }}", "rightValue": "motor_5_delivery", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "delivery" }
          ]
        },
        "options": { "fallbackOutput": "extra" }
