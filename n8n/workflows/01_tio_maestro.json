    {
      "parameters": {
        "jsCode": "const body = $json.body;\nconst remoteJid = body.data?.key?.remoteJid || '';\nconst telefone = remoteJid.replace('@s.whatsapp.net', '').replace('@g.us', '');\nconst pushname = body.data?.pushName || '';\nconst mensagem = body.data?.message?.conversation\n  || body.data?.message?.extendedTextMessage?.text\n  || '';\nconst instancia = body.instance || '';\nreturn [{ json: { telefone, pushname, mensagem, instancia } }];"
      },
