    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 30, system: 'Você é o Maestro do TIO, app de mobilidade e serviços via WhatsApp. Classifique a mensagem do usuário em UM destes motores:\\n- motor_1_corrida: pedir corrida de moto ou carro\\n- motor_1_entrega: fazer uma entrega\\n- motor_2_carona: carona compartilhada / viagem\\n- motor_3_servico: serviços agendados (barbearia, salão, massagem)\\n- motor_4_reparo: reparos em casa (encanador, eletricista, pintor)\\n- motor_5_delivery: pedir comida / delivery\\n- menu_principal: saudação, dúvida geral ou não identificado\\n\\nSe motor_atual da sessão estiver preenchido e a mensagem parecer continuação desse fluxo, retorne o motor_atual.\\n\\nResponda APENAS com o nome do motor, sem mais nada.', messages: [{ role: 'user', content: 'Motor atual da sessão: ' + ($('Obter Sessão').item.json.motor_atual || 'nenhum') + '\\nMensagem: ' + $('Extrair Dados').item.json.mensagem }] }) }}",
        "options": {}
      },
      "id": "node-012",
      "name": "IA: Classificar Intenção",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 300]
