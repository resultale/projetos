{
  "name": "07 TIO Motor 4 - Reparos (Orçamento)",
  "nodes": [
    {
      "parameters": { "inputDataFieldName": "body" },
      "id": "trigger",
      "name": "Chamado pelo Maestro",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [120, 400]
    },
    {
      "parameters": {
        "jsCode": "const d = $json;\nconst ctx = d.sessao_contexto || {};\nconst etapa = ctx.etapa || 'inicio';\nreturn [{ json: { etapa, mensagem: d.mensagem, dados: d, contexto: ctx } }];"
      },
      "id": "detectar-etapa",
      "name": "Detectar Etapa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [340, 400]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.etapa }}", "rightValue": "inicio", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "inicio" },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.etapa }}", "rightValue": "coletando_detalhes", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "coletando_detalhes" },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.etapa }}", "rightValue": "aguardando_escolha_prestador", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "aguardando_escolha" }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "switch-etapa",
      "name": "Switch Etapa",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [560, 400]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 300,\n  \"system\": \"O usuário precisa de um profissional para reparo. Analise a mensagem e responda em JSON: { tipo_profissional: 'eletricista'|'encanador'|'pintor'|'marido_aluguel'|'ar_condicionado'|'outros', descricao_problema: string, precisa_mais_info: boolean, pergunta_adicional: string_ou_null }. Se o problema não estiver claro, peça uma informação específica. Responda APENAS o JSON.\",\n  \"messages\": [{ \"role\": \"user\", \"content\": \"{{ $('Detectar Etapa').item.json.mensagem }}\" }]\n}"
      },
      "id": "ia-analisar-problema",
      "name": "IA: Analisar Problema",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [800, 240]
    },
    {
      "parameters": {
        "jsCode": "const resp = $json;\nlet dados = {};\ntry {\n  dados = JSON.parse(resp.content?.[0]?.text?.trim() || '{}');\n} catch(e) { dados = { tipo_profissional: 'outros', descricao_problema: $('Detectar Etapa').item.json.mensagem, precisa_mais_info: false }; }\nreturn [{ json: dados }];"
      },
      "id": "processar-problema",
      "name": "Processar Problema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [{ "leftValue": "={{ $json.precisa_mais_info }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }],
          "combinator": "and"
        }
      },
      "id": "if-mais-info",
