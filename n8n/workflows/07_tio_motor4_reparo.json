    {
      "parameters": {
        "jsCode": "const prestadores = Array.isArray($json) ? $json : [];\nif (prestadores.length === 0) {\n  return [{ json: { texto: '😔 Não encontrei profissionais disponíveis agora.\\n\\nTente mais tarde!', encontrou: false, prestadores: [] } }];\n}\nconst tipo = $('Processar Problema').item.json.tipo_profissional || 'profissional';\nconst lista = prestadores.slice(0, 3).map((p, i) => `*${i+1}. ${p.nome}*\\n   ⭐ ${p.avaliacao_media || '5.0'} | 🔧 ${tipo}`).join('\\n\\n');\nreturn [{ json: { texto: `Encontrei estes profissionais:\\n\\n${lista}\\n\\nDigite o número da sua escolha!`, encontrou: true, prestadores } }];"
      },
